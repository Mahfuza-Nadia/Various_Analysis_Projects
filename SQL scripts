-- Rolling Vaccination for Countries


SELECT
    country,
    date,
    new_vaccinations,
    SUM (new_vaccinations) OVER (PARTITION by country Order by country, date) AS RollingPeopleVaccinations


-- Using CTE for Percentage of Vaccinated for Countries


From test1-383919.compact_1789039854647.compact
Where Continent is not null
Order by 1,2
WITH VaccinationData AS (
    SELECT
        country,
        date,
        new_vaccinations,
        population,
        SUM(new_vaccinations) OVER (
            PARTITION BY country
            ORDER BY date
        ) AS RollingPeopleVaccinations
    FROM `test1-383919.compact_1789039854647.compact`
    WHERE Continent IS NOT NULL
)




SELECT
    country,
    date,
    new_vaccinations,
    population,
    RollingPeopleVaccinations,
    (RollingPeopleVaccinations / population) * 100 AS PercentageVaccinated
FROM VaccinationData
ORDER BY 1, 2;


